import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark(),
      home: const ResumeTemplateScreen(),
    );
  }
}

class ResumeTemplateScreen extends StatefulWidget {
  const ResumeTemplateScreen({super.key});

  @override
  State<ResumeTemplateScreen> createState() =>
      _ResumeTemplateScreenState();
}

class _ResumeTemplateScreenState extends State<ResumeTemplateScreen> {
  String selectedCategory = "All Designs";
  int selectedNavIndex = 1;
  int? selectedTemplateIndex;

  final List<String> categories = [
    "All Designs",
    "Modern",
    "Professional",
    "Creative",
    "Academic"
  ];

  final List<Map<String, dynamic>> templates = [
    {
      "name": "Executive Edge",
      "category": "Professional",
      "image": "https://picsum.photos/200/300?1",
      "premium": true,
      "tag": "Used by 12k+"
    },
    {
      "name": "Berlin Minimal",
      "category": "Modern",
      "image": "https://picsum.photos/200/300?2",
      "premium": false,
      "tag": "Trending"
    },
    {
      "name": "Creative Canvas",
      "category": "Creative",
      "image": "https://picsum.photos/200/300?3",
      "premium": true,
      "tag": "Used by 5k+"
    },
    {
      "name": "Scholar Elite",
      "category": "Academic",
      "image": "https://picsum.photos/200/300?4",
      "premium": false,
      "tag": "Classic"
    },
    {
      "name": "Nova Dark",
      "category": "Modern",
      "image": "https://picsum.photos/200/300?5",
      "premium": true,
      "tag": "Used by 8k+"
    },
    {
      "name": "Classic Corporate",
      "category": "Professional",
      "image": "https://picsum.photos/200/300?6",
      "premium": false,
      "tag": "Top Rated"
    },
  ];

  List<Map<String, dynamic>> get filteredTemplates {
    if (selectedCategory == "All Designs") return templates;
    return templates
        .where((t) => t["category"] == selectedCategory)
        .toList();
  }

  @override
  Widget build(BuildContext context) {
    final filtered = filteredTemplates;

    return Scaffold(
      backgroundColor: const Color(0xFF0D1117),

      // ✅ AppBar
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back),
          onPressed: () => Navigator.pop(context),
        ),
        title: const Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text("Pick Template", style: TextStyle(fontSize: 18)),
            Text("Step 1 of 3: Layout",
                style: TextStyle(fontSize: 12, color: Colors.grey)),
          ],
        ),
        actions: [
          IconButton(
            icon: const Icon(Icons.search),
            onPressed: () {
              ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text("Search clicked")));
            },
          )
        ],
      ),

      // ✅ Body
      body: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          children: [

            // AI Card
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(16),
                gradient: const LinearGradient(
                    colors: [Colors.blue, Colors.blueAccent]),
              ),
              child: const Row(
                children: [
                  Icon(Icons.auto_awesome, color: Colors.white),
                  SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      "Modern layouts can increase interview chances by 35% for Tech roles.",
                      style: TextStyle(color: Colors.white),
                    ),
                  ),
                ],
              ),
            ),

            const SizedBox(height: 16),

            // Filter Chips
            SizedBox(
              height: 40,
              child: ListView.builder(
                scrollDirection: Axis.horizontal,
                itemCount: categories.length,
                itemBuilder: (_, i) {
                  final cat = categories[i];
                  final selected = cat == selectedCategory;

                  return GestureDetector(
                    onTap: () {
                      setState(() => selectedCategory = cat);
                    },
                    child: Container(
                      margin: const EdgeInsets.only(right: 10),
                      padding: const EdgeInsets.symmetric(
                          horizontal: 16, vertical: 8),
                      decoration: BoxDecoration(
                        color: selected
                            ? Colors.blue
                            : Colors.grey.shade800,
                        borderRadius: BorderRadius.circular(20),
                      ),
                      child: Center(child: Text(cat)),
                    ),
                  );
                },
              ),
            ),

            const SizedBox(height: 16),

            // Grid
            Expanded(
              child: GridView.builder(
                itemCount: filtered.length,
                gridDelegate:
                    const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 2,
                  mainAxisSpacing: 12,
                  crossAxisSpacing: 12,
                  childAspectRatio: 0.7,
                ),
                itemBuilder: (_, i) {
                  final item = filtered[i];
                  final isSelected =
                      templates.indexOf(item) == selectedTemplateIndex;

                  return _TemplateCard(
                    data: item,
                    isSelected: isSelected,
                    onTap: () {
                      setState(() {
                        selectedTemplateIndex =
                            templates.indexOf(item);
                      });
                    },
                  );
                },
              ),
            ),

            const Text(
              "All templates are ATS-friendly and printable",
              style: TextStyle(color: Colors.grey, fontSize: 12),
            ),
          ],
        ),
      ),

      // ✅ FAB
      floatingActionButton: FloatingActionButton(
        onPressed: () {
          ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text("Create new template")));
        },
        child: const Icon(Icons.add),
      ),

      // ✅ Bottom Navigation
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: selectedNavIndex,
        onTap: (i) {
          setState(() => selectedNavIndex = i);
          final names = ["Home", "Designs", "My Files", "Profile"];
          ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text("${names[i]} clicked")));
        },
        items: const [
          BottomNavigationBarItem(icon: Icon(Icons.home), label: "Home"),
          BottomNavigationBarItem(icon: Icon(Icons.grid_view), label: "Designs"),
          BottomNavigationBarItem(icon: Icon(Icons.folder), label: "My Files"),
          BottomNavigationBarItem(icon: Icon(Icons.person), label: "Profile"),
        ],
      ),
    );
  }
}

// ✅ Template Card Widget
class _TemplateCard extends StatelessWidget {
  final Map<String, dynamic> data;
  final bool isSelected;
  final VoidCallback onTap;

  const _TemplateCard({
    required this.data,
    required this.isSelected,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return Stack(
      children: [
        Container(
          decoration: BoxDecoration(
            color: Colors.grey.shade900,
            borderRadius: BorderRadius.circular(16),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Image
              ClipRRect(
                borderRadius:
                    const BorderRadius.vertical(top: Radius.circular(16)),
                child: Image.network(
                  data["image"],
                  height: 120,
                  width: double.infinity,
                  fit: BoxFit.cover,
                ),
              ),

              Padding(
                padding: const EdgeInsets.all(8),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(data["name"],
                        style: const TextStyle(
                            fontWeight: FontWeight.bold)),
                    Text(
                      "${data["category"]} • ${data["tag"]}",
                      style:
                          const TextStyle(fontSize: 12, color: Colors.grey),
                    ),
                    const SizedBox(height: 8),

                    ElevatedButton(
                      onPressed: onTap,
                      style: ElevatedButton.styleFrom(
                        backgroundColor:
                            isSelected ? Colors.blue : Colors.grey,
                      ),
                      child: Text(
                          isSelected ? "Selected" : "Choose Template"),
                    )
                  ],
                ),
              )
            ],
          ),
        ),

        // Premium Badge
        if (data["premium"])
          Positioned(
            top: 8,
            left: 8,
            child: Container(
              padding: const EdgeInsets.all(4),
              color: Colors.amber,
              child: const Text("PREMIUM",
                  style: TextStyle(fontSize: 10)),
            ),
          ),

        // Selected Overlay
        if (isSelected)
          const Positioned(
            top: 8,
            right: 8,
            child: Icon(Icons.check_circle, color: Colors.blue),
          ),
      ],
    );
  }
}
