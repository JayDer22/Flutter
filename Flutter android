              ),
            ),
          ),
          const ResumePreviewWidget(),
        ],
      ),
    );
  }
}

class ResumePreviewWidget extends StatelessWidget {
  const ResumePreviewWidget({super.key});

  Widget _buildPreviewSectionTitle(String title) {
    return Padding(
      padding: const EdgeInsets.only(top: 24.0, bottom: 12.0), // Increased spacing
      child: Text(
        title.toUpperCase(),
        style: const TextStyle(
          color: goldPrimary,
          fontSize: 14,
          fontWeight: FontWeight.bold,
          letterSpacing: 2.0, // Increased letter spacing
        ),
      ),
    );
  }

  Widget _buildPreviewText(String text, {TextStyle? style, EdgeInsetsGeometry padding = const EdgeInsets.symmetric(vertical: 4.0)}) {
    if (text.isEmpty) return const SizedBox.shrink();
    return Padding(
      padding: padding,
      child: Text(text, style: style ?? const TextStyle(color: textPrimary, fontSize: 14)),
    );
  }

  Widget _buildGoldBulletPoint(String text) {
    if (text.isEmpty) return const SizedBox.shrink();
    return Padding(
      padding: const EdgeInsets.only(left: 12.0, top: 4.0, bottom: 4.0), // Adjusted spacing
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          const Icon(Icons.circle, color: goldPrimary, size: 6), // Small gold circle
          const SizedBox(width: 8),
          Expanded(child: Text(text, style: const TextStyle(color: textPrimary, fontSize: 13, height: 1.5))), // Added height for readability
        ],
      ),
    );
  }

  Widget _buildGlassmorphicContentBlock({required Widget child, EdgeInsetsGeometry? padding}) {
    return ClipRRect(
      borderRadius: BorderRadius.circular(12), // Rounded corners for content blocks
      child: BackdropFilter(
        filter: ImageFilter.blur(sigmaX: 5.0, sigmaY: 5.0), // Frosted glass blur
        child: Container(
          width: double.infinity,
          padding: padding ?? const EdgeInsets.all(16), // Consistent padding
          decoration: BoxDecoration(
            color: cardColor.withOpacity(0.3), // Semi-transparent
            borderRadius: BorderRadius.circular(12), // Redundant here if ClipRRect is used, but good for consistency
            border: Border.all(color: borderColor.withOpacity(0.2), width: 1), // Subtle border
          ),
          child: child,
        ),
      ),
    );
  }

  // Helper to build the personal information content block
  Widget _buildPersonalInformationContent(ResumeData resumeData) {
    final List<Widget> personalInfoWidgets = <Widget>[];

    if (resumeData.name.isNotEmpty) {
      personalInfoWidgets.add(_buildPreviewText(
        resumeData.name,
        style: const TextStyle(color: goldPrimary, fontSize: 36, fontWeight: FontWeight.bold),
        padding: EdgeInsets.zero, // Padding handled by the outer GlassmorphicContentBlock
      ));
    }
    if (resumeData.jobTitle.isNotEmpty) {
      personalInfoWidgets.add(_buildPreviewText(
        resumeData.jobTitle,
        style: const TextStyle(color: textPrimary, fontSize: 20, fontWeight: FontWeight.w600),
        padding: const EdgeInsets.only(top: 6.0), // Small internal padding for visual separation
      ));
    }
    final String contactInfo = <String>[resumeData.email, resumeData.phone, resumeData.linkedinOrPortfolio]
        .where((String s) => s.isNotEmpty)
        .join('  |  ');
    if (contactInfo.isNotEmpty) {
      personalInfoWidgets.add(_buildPreviewText(
        contactInfo,
        style: const TextStyle(color: textSecondary, fontSize: 14),
        padding: const EdgeInsets.only(top: 12.0), // Small internal padding for visual separation
      ));
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: personalInfoWidgets,
    );
  }

  @override
  Widget build(BuildContext context) {
    final ResumeData resumeData = context.watch<ResumeData>();

    final List<String> jobDescriptionPoints = resumeData.jobDescription
        .split('\n')
        .where((String s) => s.trim().isNotEmpty)
        .map<String>((String s) => s.trim().startsWith('•') ? s.trim().substring(1).trim() : s.trim())
        .toList();

    final List<String> skillsList = resumeData.skills
        .split(RegExp(r'[,\n]'))
        .where((String s) => s.trim().isNotEmpty)
        .map<String>((String s) => s.trim())
        .toList();

    final bool hasPersonalInfo = resumeData.name.isNotEmpty ||
        resumeData.jobTitle.isNotEmpty ||
        resumeData.email.isNotEmpty ||
        resumeData.phone.isNotEmpty ||
        resumeData.linkedinOrPortfolio.isNotEmpty;

    return Stack( // Use a stack for background elements
      children: <Widget>[
        // --- Abstract Background Elements ---
        Positioned(
          top: -50,
          left: -50,
          child: Container(
            width: 200,
            height: 200,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: goldGlow.withOpacity(0.05), // Very subtle glow
              boxShadow: <BoxShadow>[
                BoxShadow(
                  color: goldGlow.withOpacity(0.08),
                  blurRadius: 100,
                  spreadRadius: 50,
                ),
              ],
            ),
          ),
        ),
        Positioned(
          bottom: -70,
          right: -70,
          child: Container(
            width: 250,
            height: 250,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: goldGlow.withOpacity(0.05),
              boxShadow: <BoxShadow>[
                BoxShadow(
                  color: goldGlow.withOpacity(0.08),
                  blurRadius: 120,
                  spreadRadius: 60,
                ),
              ],
            ),
          ),
        ),
        Positioned(
          top: MediaQuery.of(context).size.height * 0.2,
          right: MediaQuery.of(context).size.width * 0.1,
          child: Transform.rotate(
            angle: 0.2, // Small rotation
            child: Container(
              width: 100,
              height: 100,
              decoration: BoxDecoration(
                color: surfaceColor.withOpacity(0.2), // Subtle geometric shape
                borderRadius: BorderRadius.circular(20),
                boxShadow: <BoxShadow>[
                  BoxShadow(
                    color: baseBackground.withOpacity(0.2),
                    blurRadius: 20,
                    spreadRadius: 5,
                  ),
                ],
              ),
            ),
          ),
        ),
        // Radial Gradient - subtle background lighting
        Positioned.fill(
          child: Container(
            decoration: BoxDecoration(
              gradient: RadialGradient(
                center: Alignment.topRight,
                radius: 1.0,
                colors: <Color>[
                  goldGlow.withOpacity(0.03), // Very subtle
                  baseBackground,
                ],
                stops: const <double>[0.0, 0.9],
              ),
            ),
          ),
        ),

        // --- Resume Card (Glassmorphism effect) ---
        SingleChildScrollView(
          padding: const EdgeInsets.symmetric(vertical: 24.0, horizontal: 16.0), // Overall vertical and horizontal padding
          child: Center(
            child: ClipRRect( // ClipRRect for the main card's rounded corners and blur
              borderRadius: BorderRadius.circular(24), // Increased rounded corners
              child: BackdropFilter(
                filter: ImageFilter.blur(sigmaX: 10.0, sigmaY: 10.0), // Main card blur
                child: Container(
                  width: MediaQuery.of(context).size.width * 0.9,
                  constraints: const BoxConstraints(maxWidth: 800),
                  padding: const EdgeInsets.all(30),
                  decoration: BoxDecoration(
                    color: cardColor.withOpacity(0.4), // Semi-transparent card
                    borderRadius: BorderRadius.circular(24), // Redundant here if ClipRRect is used, but good for consistency and standalone use.
                    border: Border.all(color: borderColor.withOpacity(0.3), width: 1), // Subtle border
                    boxShadow: <BoxShadow>[
                      BoxShadow(
                        color: goldGlow.withOpacity(0.2), // Soft glow shadow
                        blurRadius: 30,
                        spreadRadius: 8,
                        offset: const Offset(0, 10),
                      ),
                      BoxShadow( // Deeper shadow for elevation
                        color: baseBackground.withOpacity(0.6),
                        blurRadius: 20,
                        spreadRadius: 2,
                        offset: const Offset(0, 5),
                      ),
                    ],
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: <Widget>[
                      // --- Header Section (Personal Information) ---
                      if (hasPersonalInfo)
                        _buildGlassmorphicContentBlock(
                          padding: const EdgeInsets.all(24), // Adjusted padding for this block
                          child: _buildPersonalInformationContent(resumeData),
                        ),
                      if (hasPersonalInfo) ...<Widget>[
                        const SizedBox(height: 24), // Spacing before divider
                        const Divider(color: borderColor, height: 1, thickness: 0.5), // Thinner divider
                        const SizedBox(height: 24), // Increased spacing after divider
                      ],

                      // --- Summary ---
                      if (resumeData.summary.isNotEmpty) ...<Widget>[
                        _buildPreviewSectionTitle("Summary"),
                        _buildGlassmorphicContentBlock(
                          padding: const EdgeInsets.all(16),
                          child: _buildPreviewText(
                            resumeData.summary,
                            style: const TextStyle(color: textPrimary, fontSize: 14, height: 1.6),
                            padding: EdgeInsets.zero, // Padding handled by block
                          ),
                        ),
                        const SizedBox(height: 30), // Increased space after section
                      ],

                      // --- Experience ---
                      if (resumeData.jobTitle.isNotEmpty || resumeData.jobDescription.isNotEmpty) ...<Widget>[
                        _buildPreviewSectionTitle("Experience"),
                        _buildGlassmorphicContentBlock(
                          padding: const EdgeInsets.all(16),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: <Widget>[
                              if (resumeData.jobTitle.isNotEmpty)
                                _buildPreviewText(
                                  resumeData.jobTitle,
                                  style: const TextStyle(color: textPrimary, fontSize: 16, fontWeight: FontWeight.bold),
                                  padding: const EdgeInsets.only(bottom: 4.0),
                                ),
                              if (resumeData.company.isNotEmpty || resumeData.jobLocation.isNotEmpty)
                                _buildPreviewText(
                                  '${resumeData.company}${resumeData.company.isNotEmpty && resumeData.jobLocation.isNotEmpty ? ' - ' : ''}${resumeData.jobLocation}',
                                  style: const TextStyle(color: textSecondary, fontSize: 13, fontStyle: FontStyle.italic),
                                  padding: const EdgeInsets.only(bottom: 4.0),
                                ),
                              if (resumeData.jobStartDate.isNotEmpty || resumeData.jobEndDate.isNotEmpty)
                                _buildPreviewText(
                                  '${resumeData.jobStartDate}${resumeData.jobStartDate.isNotEmpty && resumeData.jobEndDate.isNotEmpty ? ' - ' : ''}${resumeData.jobEndDate}',
                                  style: const TextStyle(color: textSecondary, fontSize: 12),
                                  padding: const EdgeInsets.only(bottom: 12.0), // Spacing before description
                                ),
                              if (jobDescriptionPoints.isNotEmpty)
                                Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: jobDescriptionPoints.map<Widget>((String point) => _buildGoldBulletPoint(point)).toList(),
                                ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 30), // Increased space after section
                      ],

                      // --- Education ---
                      if (resumeData.degree.isNotEmpty || resumeData.educationDetails.isNotEmpty) ...<Widget>[
                        _buildPreviewSectionTitle("Education"),
                        _buildGlassmorphicContentBlock(
                          padding: const EdgeInsets.all(16),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: <Widget>[
                              if (resumeData.degree.isNotEmpty)
                                _buildPreviewText(
                                  resumeData.degree,
                                  style: const TextStyle(color: textPrimary, fontSize: 16, fontWeight: FontWeight.bold),
                                  padding: const EdgeInsets.only(bottom: 4.0),
                                ),
                              if (resumeData.university.isNotEmpty || resumeData.educationLocation.isNotEmpty)
                                _buildPreviewText(
                                  '${resumeData.university}${resumeData.university.isNotEmpty && resumeData.educationLocation.isNotEmpty ? ' - ' : ''}${resumeData.educationLocation}',
                                  style: const TextStyle(color: textSecondary, fontSize: 13, fontStyle: FontStyle.italic),
                                  padding: const EdgeInsets.only(bottom: 4.0),
                                ),
                              if (resumeData.educationStartDate.isNotEmpty || resumeData.educationEndDate.isNotEmpty)
                                _buildPreviewText(
                                  '${resumeData.educationStartDate}${resumeData.educationStartDate.isNotEmpty && resumeData.educationEndDate.isNotEmpty ? ' - ' : ''}${resumeData.educationEndDate}',
                                  style: const TextStyle(color: textSecondary, fontSize: 12),
                                  padding: const EdgeInsets.only(bottom: 12.0), // Spacing before details
                                ),
                              if (resumeData.educationDetails.isNotEmpty)
                                _buildPreviewText(
                                  resumeData.educationDetails,
                                  style: const TextStyle(color: textPrimary, fontSize: 14, height: 1.5),
                                  padding: EdgeInsets.zero,
                                ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 30), // Increased space after section
                      ],

                      // --- Skills ---
                      if (skillsList.isNotEmpty) ...<Widget>[
                        _buildPreviewSectionTitle("Skills"),
                        _buildGlassmorphicContentBlock(
                          padding: const EdgeInsets.all(16),
                          child: Wrap(
                            spacing: 12.0, // Increased spacing between chips
                            runSpacing: 12.0, // Increased run spacing
                            children: skillsList.map<Widget>((String skill) {
                              return Chip(
                                label: Text(skill, style: const TextStyle(color: goldLight, fontSize: 14, fontWeight: FontWeight.w500)), // Larger font, goldLight
                                backgroundColor: Colors.transparent, // Transparent fill
                                side: BorderSide(color: goldPrimary.withOpacity(0.5)), // GoldPrimary border
                                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8), // More padding
                                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)), // Pill shape
                                elevation: 2, // Slight elevation
                                shadowColor: goldGlow.withOpacity(0.1), // Soft glow for chips
                              );
                            }).toList(),
                          ),
                        ),
                        const SizedBox(height: 30), // Increased space after skills section
                      ],
                    ],
                  ),
                ),
              ),
            ),
          ),
        ),
      ],
    );
  }
}
